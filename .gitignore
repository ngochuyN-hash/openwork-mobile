node_modules/
web/dist/
*.log

# scratch files from one-off test scripts (they self-declare "temporary")
_tmp-*
# ad-hoc scratch dirs from a patch session (owm-<random>/). Nothing in the repo
# is ever named like this, so ignore the whole shape rather than one instance.
owm-*/
# Windows redirect artifact: `cmd > nul` / `> nul` writes a real 0-byte file
# named "nul" here on the bash/git-bash layer. Pure noise, never real content.
nul
.DS_Store
Thumbs.db
.zcode/

# desktop GUI build artifact — the exe embeds the real worker URL string and
# binaries cannot go through the pre-push washer, so keep it local-only
desktop/bin/

# friend installer bundle (built locally: bridge + web/dist + exe + guide)
openwork-bridge-friend.zip

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# OTA publish staging (kênh OTA đã gỡ — giữ ignore phòng khi thư mục tái xuất hiện)
worker/ota-publish/

# agent/session working dirs (machine-local, not part of the repo)
.agents/
.cluster/
.openclaw/
.zcodeignore

# agent persona / user profile — describes the person and the agent, not the
# product. Machine-local: never publish.
/SOUL.md
/USER.md
/IDENTITY.md
/TOOLS.md
/HEARTBEAT.md

# publishing washer hook is machine-local (never published to the remote)
.githooks/

# wrangler local cache (account info — never publish)
worker/.wrangler/

# Mimosa security-scan plugin: per-session hook state + scan metadata (machine-local)
.mimosa/

# GUI test build manifest (asInvoker copy for runtime testing)
desktop/src/app-test.manifest
OpenPocket-Setup.exe

# room invite key baked into the desktop exe at build time (machine-local
# secret: exe builds from this repo WITHOUT it cannot create rooms on the
# worker — that is the point). src/InviteKey.cs is generated from it by the
# build scripts and must never be committed either.
desktop/invite.key
desktop/src/InviteKey.cs

# generated machine-identity whitelist — the committed source of truth is
# shared/identity-keys.txt (bridge reads it at runtime; build scripts turn it
# into this C# file). Same generated-file pattern as InviteKey.cs above.
desktop/src/IdentityKeys.cs

# generated host contract — the committed source of truth is
# shared/host-contract.js (bridge imports it directly; gen-host-contract.mjs
# turns it into this C# file at build time). Same pattern as IdentityKeys.cs.
# ErrorCode.cs is generated the same way from shared/contract.js (the
# cross-tier error codes the desktop exe compares).
desktop/src/HostContract.cs
desktop/src/ErrorCode.cs
